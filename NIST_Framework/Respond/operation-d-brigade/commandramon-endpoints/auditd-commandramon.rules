# operation-d-brigade/commandramon-endpoints/auditd-commandramon.rules

# Monitor execution of network tool binaries
-w /usr/bin/nc -p x -k commandramon_netcat
-w /usr/bin/nmap -p x -k commandramon_recon
-w /usr/bin/curl -p x -k commandramon_fetch

# Monitor privilege escalation attempts
-w /etc/sudoers -p wa -k commandramon_priv_esc
-w /etc/shadow -p wa -k commandramon_shadow_access
